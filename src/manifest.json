{
  "manifest_version": 3,
  "name": "Zen Home",
  "version": "1.0.0",
  "description": "Личная стартовая страница Zen: часы, Essentials и календарь.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-home@mrkvqv",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "assets/icon.svg",
    "96": "assets/icon.svg"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "chrome_settings_overrides": {
    "homepage": "home.html"
  },
  "action": {
    "default_title": "Стартовая страница",
    "default_icon": "assets/icon.svg"
  },
  "commands": {
    "open-home": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "MacCtrl+Shift+H"
      },
      "description": "Открыть стартовую страницу"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; connect-src http://127.0.0.1:8766; style-src 'self'; font-src 'self'; default-src 'self'"
  }
}
